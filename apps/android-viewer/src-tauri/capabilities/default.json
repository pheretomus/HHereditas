{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "default",
  "description": "Permissions of the main window: pick files with the native dialog and read them.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:read-files",
    {
      "identifier": "fs:scope",
      "allow": ["**", "content://**"]
    }
  ]
}
